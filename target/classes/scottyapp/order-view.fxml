<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="840.0" prefWidth="1150.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scottyapp.Order.OrderController">
    <children>

        <TableView fx:id="orderTableView" prefHeight="300.0" prefWidth="1150.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <columns>
                <TableColumn fx:id="idOrderColumn" prefWidth="90.0" text="ID Pedido" />
                <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Fecha" />
                <TableColumn fx:id="totalColumn" prefWidth="120.0" text="Total EUR" />
                <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Estado" />
                <TableColumn fx:id="idUserColumn" prefWidth="90.0" text="ID Usuario" />
                <TableColumn fx:id="userNameColumn" prefWidth="300.0" text="Cliente" />
            </columns>
        </TableView>

        <TextField fx:id="buscarTextField" layoutX="14.0" layoutY="314.0" prefHeight="32.0" prefWidth="280.0" promptText="Buscar por nº pedido, cliente o estado" />
        <Button layoutX="304.0" layoutY="314.0" mnemonicParsing="false" onAction="#buscarButton" prefHeight="32.0" prefWidth="70.0" text="Buscar" />
        <Button fx:id="nuevoButton" styleClass="btn-primary" layoutX="1014.0" layoutY="314.0" mnemonicParsing="false" onAction="#nuevoButton" prefHeight="32.0" prefWidth="120.0" text="Nuevo pedido" />
        <Button fx:id="editarButton" styleClass="btn-secondary" disable="true" layoutX="680.0" layoutY="314.0" mnemonicParsing="false" onAction="#editarButton" prefHeight="32.0" prefWidth="110.0" text="Editar estado" />
        <Button fx:id="eliminarButton" styleClass="btn-danger" disable="true" layoutX="800.0" layoutY="314.0" mnemonicParsing="false" onAction="#eliminarButton" prefHeight="32.0" prefWidth="90.0" text="Eliminar" />
        <Button fx:id="verDetallesButton" styleClass="btn-secondary" disable="true" layoutX="900.0" layoutY="314.0" mnemonicParsing="false" onAction="#verDetallesButton" prefHeight="32.0" prefWidth="104.0" text="Ver detalles" />

        <Label text="ID:" layoutX="14.0" layoutY="365.0" />
        <TextField fx:id="idOrderTextField" layoutX="35.0" layoutY="362.0" prefHeight="28.0" prefWidth="55.0" promptText="ID" disable="true" />
        <Label text="Fecha:" layoutX="102.0" layoutY="365.0" />
        <TextField fx:id="dateTextField" layoutX="147.0" layoutY="362.0" prefHeight="28.0" prefWidth="130.0" promptText="YYYY-MM-DD" />
        <Label text="Cliente:" layoutX="290.0" layoutY="365.0" />
        <ComboBox fx:id="usuarioComboBox" layoutX="342.0" layoutY="362.0" prefHeight="28.0" prefWidth="220.0" promptText="Selecciona cliente" />
        <Label text="Estado:" layoutX="576.0" layoutY="365.0" />
        <SplitMenuButton fx:id="statusMenuButton" layoutX="626.0" layoutY="360.0" prefHeight="28.0" prefWidth="150.0" text="Estado">
            <items>
                <MenuItem mnemonicParsing="false" text="PENDING" />
                <MenuItem mnemonicParsing="false" text="PROCESSED" />
                <MenuItem mnemonicParsing="false" text="CANCELLED" />
            </items>
        </SplitMenuButton>
        <Label text="Total EUR:" layoutX="790.0" layoutY="365.0" />
        <TextField fx:id="totalTextField" layoutX="853.0" layoutY="362.0" prefHeight="28.0" prefWidth="100.0" promptText="0.00" disable="true" />
        <Button fx:id="guardarButton" styleClass="btn-primary" disable="true" layoutX="1014.0" layoutY="360.0" mnemonicParsing="false" onAction="#guardarButton" prefHeight="32.0" prefWidth="120.0" text="Guardar" />

        <Label fx:id="modoLabel" styleClass="mensaje" layoutX="14.0" layoutY="408.0" prefWidth="700.0" text="" />

        <Label fx:id="mensajeLabel" styleClass="mensaje" layoutX="14.0" layoutY="760.0" prefHeight="27.0" prefWidth="600.0" text="" />
        <Button styleClass="btn-back" layoutX="14.0" layoutY="800.0" mnemonicParsing="false" onAction="#volverButton" text="Volver al menu principal" />

    </children>
</AnchorPane>